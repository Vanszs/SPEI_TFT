# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
env/
.env

# Project Data (Large files — top-level only)
/data/
/data/raw/
/data/processed/
*.parquet
*.csv



# Output Results (top-level only)
/results/
*.png
*.jpg

# Editor / IDE
.vscode/
.idea/

# Custom Debug Scripts (Optional, keep if needed)
debug_*.py
inspect_results.py

# Lightning & training logs
lightning_logs/
notebooks/lightning_logs/
logs/lightning_logs/
/logs

# Pycache (recursive)
**/__pycache__/
*.pyc

# Archived artifacts
# (old checkpoints, stale eval runs, etc.)
*.ckpt
logs/checkpoints/
logs/archive_*/
results_archive_*/
# Frontend build output & deps (handled by frontend/.gitignore too, kept here for safety)
frontend/node_modules/
frontend/dist/

# Browser QA session artifacts (Playwright MCP)
.playwright-mcp/
